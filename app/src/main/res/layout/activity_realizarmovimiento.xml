<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- ENCABEZADO CON LOGO Y BOTÓN SALIR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LIBRIS"
            android:textColor="#7D4948"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSalirMovimiento"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Regresar" />
    </LinearLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Realizar movimiento"
        android:textColor="#7D4948"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="28dp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del libro"
        android:textColor="#7D4948"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etNombreLibro"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Ej. Cien años de soledad"
        android:inputType="textCapSentences"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Autor"
        android:textColor="#7D4948"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etAutorLibro"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Ej. Gabriel García Márquez"
        android:inputType="textPersonName"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editorial"
        android:textColor="#7D4948"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etEditorialLibro"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Ej. Editorial Sudamericana"
        android:inputType="textCapWords"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginBottom="32dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnPedirPrestado"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Pedir prestado"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7D4948"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDevolverLibro"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Devolver"
            android:textColor="#7D4948"
            android:backgroundTint="#EBE5E5"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>