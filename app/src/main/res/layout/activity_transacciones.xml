<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LIBRIS"
            android:textColor="#7D4948"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSalirTransacciones"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Regresar" />
    </LinearLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Donar libro"
        android:textColor="#7D4948"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del libro"
        android:textColor="#7D4948"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDonarNombre"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Ej. El Principito"
        android:inputType="textCapSentences"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:layout_marginBottom="12dp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Autor"
        android:textColor="#7D4948"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDonarAutor"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Ej. Antoine de Saint-Exupéry"
        android:inputType="textPersonName"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:layout_marginBottom="12dp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editorial"
        android:textColor="#7D4948"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDonarEditorial"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Ej. Editorial Salamandra"
        android:inputType="textCapWords"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:layout_marginBottom="16dp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado físico del libro"
        android:textColor="#7D4948"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/ivFotoLibro"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="#EBE5E5"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Foto del estado" />

        <Button
            android:id="@+id/btnTomarFoto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Tomar foto"
            android:textColor="#7D4948"
            android:backgroundTint="#EBE5E5"
            android:textStyle="bold" />
    </LinearLayout>


    <Button
        android:id="@+id/btnConfirmarDonacion"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Registrar donación"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7D4948"
        android:textStyle="bold" />

</LinearLayout>